# ==========================================================
#  OwnForm 环境配置样例：复制为 .env 后按需修改
#  （数据库连接不在这里配置，由安装向导写入 config/db_local.php）
# ==========================================================

# 生产环境务必保持 APP_DEBUG = false
# 开启调试会把异常信息、SQL 语句、服务器绝对路径回显给任意访问者
APP_DEBUG = false

# 启用 HTTPS 后必须设为 true，否则会话 Cookie 可被窃听
COOKIE_SECURE = true

# 敏感配置加密主密钥（留空时安装向导会生成 config/secret_key.php，
# 二选一即可；设置后优先于文件）
SECRET_KEY =

# 调试 IP 白名单（APP_DEBUG = true 时仅这些 IP 可见调试信息，逗号分隔）
DEBUG_IP_ALLOWLIST = 127.0.0.1

DEFAULT_LANG = zh-cn
